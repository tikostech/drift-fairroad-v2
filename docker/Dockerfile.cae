# -----------------------------------------------------------------------------
# Stage 1: install dependencies (CPU-only PyTorch to save ~500MB+ per image)
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Current pip first: the image's pip rejects some of the CPU index's wheel metadata and falls back to sdists.
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

# -----------------------------------------------------------------------------
# Stage 2: runtime image (slim + OpenGL for image processing)
# -----------------------------------------------------------------------------
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY fl-payload/*.py ./
COPY fl-payload/models/ models/
# The IP (SL probe, CBR gate, sc) is not in this image -- it runs in the drift-fairroad-service image
# and the server reaches it through ip_client. The build fails if any IP definition gets in.
COPY ip_client/ ip_client/
RUN if grep -rqE "^(class|def) (SLCaseBase|ModelTracer|CAESLProbe|SLMinProbe|ActivationProbe|SynapsesLoggerV49|SequentialCollection|minimize|batch_layer_stats|_layer_stats|build_case_base|load_probe_images)\b" /app; then \
        echo "IP code found in the FL image" >&2; exit 1; fi

RUN mkdir -p checkpoints plots data/payload/images/clean data/payload/images/noise

ENV FL_ROLE=client
ENV FL_CLIENT_ID=client_1
ENV FL_SERVER_URL=http://fl-server-cae:5544
ENV FL_CLEAN_DIR=/app/data/payload/images/clean
ENV FL_NOISY_DIR=/app/data/payload/images/noise
ENV FL_NUM_ROUNDS=10
ENV FL_LEARNING_RATE=0.001
ENV FL_BATCH_SIZE=32
ENV FL_EPOCHS_PER_ROUND=1
ENV FL_SERVER_HOST=0.0.0.0
ENV FL_SERVER_PORT=5544
ENV FL_NUM_CLIENTS=3
ENV FL_MIN_CLIENTS=2
ENV FL_AGGREGATION=fedavg
ENV FL_CLIENT_STAGGER_SEC=10
# Extra fl_server.py flags, e.g. the SL gate through the IP services (see docker-compose.cae-ip.yml)
ENV FL_SERVER_EXTRA_ARGS=""
EXPOSE 5544

CMD ["sh", "-c", "\
    if [ \"$FL_ROLE\" = \"server\" ]; then \
        python fl_server.py \
            --host $FL_SERVER_HOST \
            --port $FL_SERVER_PORT \
            --num-clients $FL_NUM_CLIENTS \
            --min-clients $FL_MIN_CLIENTS \
            --aggregation $FL_AGGREGATION \
            $FL_SERVER_EXTRA_ARGS; \
    else \
        python fl_client_cae.py \
            --client-id $FL_CLIENT_ID \
            --clean-dir $FL_CLEAN_DIR \
            --noisy-dir $FL_NOISY_DIR \
            --server-url $FL_SERVER_URL \
            --num-rounds $FL_NUM_ROUNDS; \
    fi"]
